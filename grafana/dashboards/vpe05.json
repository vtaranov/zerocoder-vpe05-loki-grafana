{
  "uid": "vpe05-logs",
  "title": "VPe05 · Loki + Grafana",
  "tags": [
    "zerocoder",
    "VPe05",
    "loki"
  ],
  "timezone": "Europe/Moscow",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "description": "Прямой HTTP POST → Loki → Grafana. Только синтетические учебные события. Хранение 24 часа.",
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Приложение",
        "type": "custom",
        "query": "vpe05-demo",
        "current": {
          "text": "vpe05-demo",
          "value": "vpe05-demo"
        },
        "options": [
          {
            "text": "vpe05-demo",
            "value": "vpe05-demo",
            "selected": true
          }
        ]
      },
      {
        "name": "level",
        "label": "Уровень",
        "type": "custom",
        "query": "INFO,WARNING,ERROR",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "INFO",
            "value": "INFO",
            "selected": false
          },
          {
            "text": "WARNING",
            "value": "WARNING",
            "selected": false
          },
          {
            "text": "ERROR",
            "value": "ERROR",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Последние логи",
      "description": "Фильтры: приложение и уровень. Время показано в часовом поясе Москвы.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{app=\"$app\", level=~\"$level\"}",
          "queryType": "range",
          "editorMode": "code",
          "maxLines": 100,
          "direction": "backward"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "labels": true,
              "id": true,
              "tsNs": true,
              "Line": true,
              "labelTypes": true,
              "timestamp": true
            },
            "indexByName": {
              "Time": 0,
              "level": 1,
              "message": 2,
              "route": 3,
              "request_id": 4
            },
            "renameByName": {
              "Time": "Время",
              "level": "Уровень",
              "message": "Сообщение",
              "route": "Маршрут",
              "request_id": "ID запроса"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "sortBy": [
          {
            "displayName": "Время",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Уровень"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Время"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Сообщение"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 400
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Распределение по уровням",
      "description": "Количество событий за весь выбранный период: sum by (level) (count_over_time(...[$__range])).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({app=\"$app\", level=~\"$level\"}[$__range]))",
          "queryType": "instant",
          "editorMode": "code",
          "legendFormat": "{{level}}",
          "instant": true
        }
      ],
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        },
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "INFO"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "WARNING"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ERROR"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
